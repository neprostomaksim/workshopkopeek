# Скопируйте в .env и заполните. Файл .env НЕ коммитить (он в .gitignore).

# Токен бота из @BotFather (/newbot → скопировать токен)
BOT_TOKEN=123456789:AA...

# Ваш проект Supabase (URL можно публиковать)
SUPABASE_URL=https://yiaugigxfdmkicaruhsw.supabase.co

# Supabase → Project Settings → API → service_role (secret).
# ⚠️ СЕКРЕТ: обходит RLS. Только на сервере/в этом .env. Никогда не на сайте и не в git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Куда слать уведомления о новых заявках. Узнать: напишите боту /id.
# Личный чат — ваш id; можно указать id группы (добавьте бота в группу).
ADMIN_CHAT_ID=

# Meta Events Manager → ваш Pixel / Dataset.
META_PIXEL_ID=

# Meta Events Manager → Settings → Conversions API → Generate access token.
# Секрет: хранить только на сервере Render, не добавлять на сайт и в git.
META_CONVERSIONS_API_TOKEN=

# Необязательно: версия Graph API, например v26.0. Если пусто, Meta выберет версию автоматически.
META_GRAPH_API_VERSION=

# Необязательно: код из вкладки Test events. После проверки удалить из production.
META_TEST_EVENT_CODE=

# Публичный адрес лендинга, связанный с рекламой.
META_EVENT_SOURCE_URL=https://workshopkopeek.vercel.app/
