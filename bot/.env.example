# Скопируйте в .env и заполните. Файл .env НЕ коммитить (он в .gitignore).

# Токен бота из @BotFather (/newbot → скопировать токен)
BOT_TOKEN=123456789:AA...

# Ваш проект Supabase (URL можно публиковать)
SUPABASE_URL=https://yiaugigxfdmkicaruhsw.supabase.co

# Supabase → Project Settings → API → service_role (secret).
# ⚠️ СЕКРЕТ: обходит RLS. Только на сервере/в этом .env. Никогда не на сайте и не в git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Куда слать уведомления о новых заявках. Узнать: напишите боту /id.
# Личный чат — ваш id; можно указать id группы (добавьте бота в группу).
ADMIN_CHAT_ID=
